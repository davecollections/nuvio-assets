{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nuvio approved Decades artwork manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "assetBaseUrl",
    "approval",
    "heroPolicy",
    "counts",
    "fingerprint",
    "decades",
    "rootCovers",
    "delivery"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "decade-artwork"
    },
    "assetBaseUrl": {
      "type": "string",
      "minLength": 1
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "recordedAt",
        "sourcePackage",
        "reviewedManifestSha256",
        "scope",
        "nuvioPreview"
      ],
      "properties": {
        "status": {
          "const": "owner-approved"
        },
        "recordedAt": {
          "type": "string",
          "minLength": 1
        },
        "sourcePackage": {
          "type": "string",
          "minLength": 1
        },
        "reviewedManifestSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "nuvioPreview": {
          "enum": [
            "pending",
            "reviewed"
          ]
        }
      }
    },
    "heroPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "refresh",
        "currentDecadeThrough",
        "mixedSelection",
        "earlierBucket",
        "selection"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "refresh": {
          "type": "string",
          "minLength": 1
        },
        "currentDecadeThrough": {
          "type": "string",
          "minLength": 1
        },
        "mixedSelection": {
          "type": "string",
          "minLength": 1
        },
        "earlierBucket": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decades",
        "sets",
        "assets",
        "parentCovers",
        "totalImageFiles"
      ],
      "properties": {
        "decades": {
          "const": 8
        },
        "sets": {
          "const": 24
        },
        "assets": {
          "const": 96
        },
        "parentCovers": {
          "const": 2
        },
        "totalImageFiles": {
          "const": 98
        }
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decades": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "1950s-earlier",
        "1960s",
        "1970s",
        "1980s",
        "1990s",
        "2000s",
        "2010s",
        "2020s"
      ],
      "properties": {
        "1950s-earlier": {
          "$ref": "#/$defs/group"
        },
        "1960s": {
          "$ref": "#/$defs/group"
        },
        "1970s": {
          "$ref": "#/$defs/group"
        },
        "1980s": {
          "$ref": "#/$defs/group"
        },
        "1990s": {
          "$ref": "#/$defs/group"
        },
        "2000s": {
          "$ref": "#/$defs/group"
        },
        "2010s": {
          "$ref": "#/$defs/group"
        },
        "2020s": {
          "$ref": "#/$defs/group"
        }
      }
    },
    "rootCovers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "movies",
        "series"
      ],
      "properties": {
        "movies": {
          "$ref": "#/$defs/rootCover"
        },
        "series": {
          "$ref": "#/$defs/rootCover"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "dimensionsPreserved",
        "transparentTitleLogos",
        "photoCompression",
        "sourceManifestSha256",
        "setBytesBefore",
        "setBytesAfter",
        "setBytesSaved",
        "setReductionPercent"
      ],
      "properties": {
        "format": {
          "type": "string"
        },
        "dimensionsPreserved": {
          "type": "boolean"
        },
        "transparentTitleLogos": {
          "type": "string"
        },
        "photoCompression": {
          "type": "string"
        },
        "sourceManifestSha256": {
          "type": "string"
        },
        "setBytesBefore": {
          "type": "number"
        },
        "setBytesAfter": {
          "type": "number"
        },
        "setBytesSaved": {
          "type": "number"
        },
        "setReductionPercent": {
          "type": "number"
        }
      }
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "artworkLabel",
        "startYear",
        "endYear",
        "heroYears",
        "movies",
        "series",
        "mixed"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "artworkLabel": {
          "type": "string",
          "pattern": "^(1950|1960|1970|1980|1990|2000|2010|2020)s$"
        },
        "startYear": {
          "type": [
            "integer",
            "null"
          ]
        },
        "endYear": {
          "type": "integer"
        },
        "heroYears": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "integer"
          },
          "description": "Distinct release or first-air years represented by the hero sources across content types."
        },
        "movies": {
          "$ref": "#/$defs/variant"
        },
        "series": {
          "$ref": "#/$defs/variant"
        },
        "mixed": {
          "$ref": "#/$defs/variant"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableKey",
        "name",
        "mediaTypes",
        "landscape",
        "focus",
        "titleLogo",
        "hero",
        "artworkSources"
      ],
      "properties": {
        "stableKey": {
          "type": "string",
          "pattern": "^decade:(1950s-earlier|1960s|1970s|1980s|1990s|2000s|2010s|2020s):(movies|series|mixed)$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mediaTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "movie",
              "tv"
            ]
          }
        },
        "landscape": {
          "$ref": "#/$defs/landscape"
        },
        "focus": {
          "$ref": "#/$defs/focus"
        },
        "titleLogo": {
          "$ref": "#/$defs/titleLogo"
        },
        "hero": {
          "$ref": "#/$defs/hero"
        },
        "artworkSources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cover",
            "hero"
          ],
          "properties": {
            "cover": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "$ref": "#/$defs/source"
              }
            },
            "hero": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "$ref": "#/$defs/source"
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "year",
        "artworkPath",
        "sha256",
        "crop"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^(movie|tv):[1-9][0-9]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "year": {
          "type": "integer"
        },
        "releaseDate": {
          "type": "string",
          "minLength": 1
        },
        "artworkPath": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9]+\\.(jpg|png)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "crop": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4
        },
        "focalPoint": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "treatment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "horizontalMirror",
            "shiftRightFraction"
          ],
          "properties": {
            "horizontalMirror": {
              "type": "boolean"
            },
            "shiftRightFraction": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "fadeStops": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "landscape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "url",
        "sha256",
        "format",
        "width",
        "height",
        "bytes",
        "sourceSha256",
        "encoding"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^assets/collection_covers/decades/(1950s-earlier|1960s|1970s|1980s|1990s|2000s|2010s|2020s)/(movies|series|mixed)/landscape\\.webp$"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "format": {
          "const": "webp"
        },
        "width": {
          "const": 1200
        },
        "height": {
          "const": 675
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "encoding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "lossless",
            "quality",
            "effort"
          ],
          "properties": {
            "method": {
              "enum": [
                "lossless-webp",
                "perceptually-checked-webp",
                "retained-approved-webp"
              ]
            },
            "lossless": {
              "type": "boolean"
            },
            "quality": {
              "type": [
                "integer",
                "null"
              ]
            },
            "effort": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "url",
        "sha256",
        "format",
        "width",
        "height",
        "bytes",
        "sourceSha256",
        "encoding"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^assets/collection_covers/decades/(1950s-earlier|1960s|1970s|1980s|1990s|2000s|2010s|2020s)/(movies|series|mixed)/focus\\.webp$"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "format": {
          "const": "webp"
        },
        "width": {
          "const": 1200
        },
        "height": {
          "const": 675
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "encoding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "lossless",
            "quality",
            "effort"
          ],
          "properties": {
            "method": {
              "enum": [
                "lossless-webp",
                "perceptually-checked-webp",
                "retained-approved-webp"
              ]
            },
            "lossless": {
              "type": "boolean"
            },
            "quality": {
              "type": [
                "integer",
                "null"
              ]
            },
            "effort": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      }
    },
    "titleLogo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "url",
        "sha256",
        "format",
        "width",
        "height",
        "bytes",
        "sourceSha256",
        "encoding"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^assets/collection_covers/decades/(1950s-earlier|1960s|1970s|1980s|1990s|2000s|2010s|2020s)/(movies|series|mixed)/title-logo\\.webp$"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "format": {
          "const": "webp"
        },
        "width": {
          "const": 1863
        },
        "height": {
          "const": 673
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "encoding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "lossless",
            "quality",
            "effort"
          ],
          "properties": {
            "method": {
              "enum": [
                "lossless-webp",
                "perceptually-checked-webp",
                "retained-approved-webp"
              ]
            },
            "lossless": {
              "type": "boolean"
            },
            "quality": {
              "type": [
                "integer",
                "null"
              ]
            },
            "effort": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "url",
        "sha256",
        "format",
        "width",
        "height",
        "bytes",
        "sourceSha256",
        "encoding"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^assets/collection_covers/decades/(1950s-earlier|1960s|1970s|1980s|1990s|2000s|2010s|2020s)/(movies|series|mixed)/hero\\.webp$"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "format": {
          "const": "webp"
        },
        "width": {
          "const": 2560
        },
        "height": {
          "const": 1440
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "encoding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "lossless",
            "quality",
            "effort"
          ],
          "properties": {
            "method": {
              "enum": [
                "lossless-webp",
                "perceptually-checked-webp",
                "retained-approved-webp"
              ]
            },
            "lossless": {
              "type": "boolean"
            },
            "quality": {
              "type": [
                "integer",
                "null"
              ]
            },
            "effort": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      }
    },
    "rootCover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "url",
        "sha256",
        "format",
        "width",
        "height",
        "bytes",
        "sourceSha256",
        "encoding"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^assets/collection_covers/decades/(movies-by-decade|series-by-decade)\\.webp$"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "format": {
          "const": "webp"
        },
        "width": {
          "const": 1695
        },
        "height": {
          "const": 928
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "encoding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "lossless",
            "quality",
            "effort"
          ],
          "properties": {
            "method": {
              "enum": [
                "lossless-webp",
                "perceptually-checked-webp",
                "retained-approved-webp"
              ]
            },
            "lossless": {
              "type": "boolean"
            },
            "quality": {
              "type": [
                "integer",
                "null"
              ]
            },
            "effort": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "stableKey": {
          "type": "string",
          "pattern": "^decade:root:(movies|series)$"
        },
        "artworkSources": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "title",
              "year",
              "decade",
              "artworkPath",
              "sha256",
              "sourceDimensions",
              "crop",
              "treatment",
              "panel"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^(movie|tv):[0-9]+$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "year": {
                "type": "integer",
                "minimum": 1880
              },
              "decade": {
                "enum": [
                  "1950s-earlier",
                  "1960s",
                  "1970s",
                  "1980s",
                  "1990s",
                  "2000s",
                  "2010s",
                  "2020s"
                ]
              },
              "artworkPath": {
                "type": "string",
                "pattern": "^/[A-Za-z0-9]+\\.(jpg|png|webp)$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "sourceDimensions": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "width",
                  "height"
                ],
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "crop": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "left",
                  "top",
                  "width",
                  "height"
                ],
                "properties": {
                  "left": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "top": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "treatment": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "saturation",
                  "brightness",
                  "mirror"
                ],
                "properties": {
                  "saturation": {
                    "type": "number",
                    "minimum": 0
                  },
                  "brightness": {
                    "type": "number",
                    "minimum": 0
                  },
                  "mirror": {
                    "type": "boolean"
                  }
                }
              },
              "panel": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "left",
                  "top",
                  "width",
                  "height"
                ],
                "properties": {
                  "left": {
                    "type": "number",
                    "minimum": 0
                  },
                  "top": {
                    "type": "number",
                    "minimum": 0
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            }
          }
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "recordedAt",
            "sourcePackage",
            "reviewedBindingsSha256",
            "nuvioPreview"
          ],
          "properties": {
            "status": {
              "const": "owner-approved"
            },
            "recordedAt": {
              "type": "string",
              "minLength": 1
            },
            "sourcePackage": {
              "type": "string",
              "minLength": 1
            },
            "reviewedBindingsSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "nuvioPreview": {
              "enum": [
                "pending",
                "reviewed"
              ]
            }
          }
        }
      }
    }
  }
}
